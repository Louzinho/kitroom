# Copy to .env and adjust. Nothing here points outside your own machine.
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=0
PORT=5000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=kitroom
MYSQL_PASSWORD=kitroom_dev
MYSQL_DATABASE=kitroom

# The replicaSet option is required for multi-document transactions.
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGO_DATABASE=kitroom
